@startuml Cert_EET_DS01_Authentification_MFA_Session
!include ../_style.puml
' =====================================================================
'  Projet    : Cert_EET
'  Diagramme : DS-01 — Authentification, MFA et session
'  Acteur(s) : Utilisateur (tout rôle)
'  Réf.      : F7 · NF3 · ADR-08 (R1, R2) · US-AUTH-01/02/03/04/06/08/09/11/14/17 · US-NAV-01
'  Auteur    : Iyed Omri — PFE ESPRIT 2026
'  Version   : 2.0 — 18/11/2026 : réécrit d'après le code (v1.0 = conception de juillet). Ajouts : OAuth Google/GitHub, restauration au rechargement (US-AUTH-17), mot de passe oublié (US-AUTH-06), changement de mot de passe (US-AUTH-08), limites de débit (US-AUTH-13).
'  Source    : code de `main` = e7216f2 (PR #141) et engineering-log/
' =====================================================================
!pragma teoz true
autonumber "<b>0."
skinparam DefaultFontSize 10
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam LifeLineBorderThickness 1.0
skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #5D6D7E
}
skinparam actor {
  BackgroundColor #ECF0F1
  BorderColor #1B4F72
  FontStyle bold
}
skinparam database {
  BackgroundColor #EBF5FB
  BorderColor #1B4F72
}
skinparam collections {
  BackgroundColor #E8F8F5
  BorderColor #1E8449
}
skinparam control {
  BackgroundColor #FAE5D3
  BorderColor #BA4A00
}
skinparam entity {
  BackgroundColor #E8DAEF
  BorderColor #7D3C98
}
skinparam boundary {
  BackgroundColor #FDEDEC
  BorderColor #943126
}
skinparam note {
  BackgroundColor #FEF9E7
  BorderColor #B7950B
  FontSize 9
}
skinparam sequence {
  ArrowColor #34495E
  LifeLineBorderColor #7F8C8D
  LifeLineBackgroundColor #FDFEFE
  GroupBorderColor #1B4F72
  GroupHeaderFontColor #1B4F72
