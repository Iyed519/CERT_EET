@startuml Cert_EET_DS15_Gestion_Comptes_Roles
' =====================================================================
'  Projet    : Cert_EET
'  Diagramme : DS-15 — Gestion des comptes et des rôles (administrateur)
'  Acteur(s) : Administrateur, Utilisateur
'  Réf.      : F5 · F7 · US-ROL-01/02 · US-CPT-02/03/04/05 · ADR-11 · ADR-13
'  Auteur    : Iyed Omri — PFE ESPRIT 2026
'  Version   : 2.0 — 18/11/2026 : réécrit d'après le code. Création unitaire par l'administrateur (US-CPT-01) retirée (ADR-13) : remplacée par l'auto-inscription et l'import CSV.
'  Source    : code de `main` = e7216f2 (PR #141) et engineering-log/
' =====================================================================
!pragma teoz true
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam DefaultFontName "Segoe UI"
skinparam DefaultFontSize 10
skinparam dpi 120
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam ArrowThickness 1.2
skinparam LifeLineBorderThickness 1.0
skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #5D6D7E
}
skinparam actor {
  BackgroundColor #ECF0F1
  BorderColor #1B4F72
  FontStyle bold
}
skinparam database {
  BackgroundColor #EBF5FB
  BorderColor #1B4F72
}
skinparam collections {
  BackgroundColor #E8F8F5
  BorderColor #1E8449
}
skinparam control {
  BackgroundColor #FAE5D3
  BorderColor #BA4A00
}
skinparam entity {
