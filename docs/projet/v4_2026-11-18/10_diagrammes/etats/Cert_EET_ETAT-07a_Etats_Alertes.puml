@startuml Cert_EET_ETAT-07a_Etats_Alertes
!include ../_style.puml
!pragma layout elk
skinparam DefaultFontSize 11
skinparam ArrowColor #34495E
skinparam note {
  BackgroundColor #FEF9E7
  BorderColor #B7950B
  FontSize 10
}
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #1B4F72
}
title <size:14><b>Cert_EET — ETAT-07a : cycle de vie — Alertes (décrochage, surveillance)</b></size>\n<size:10>États = valeurs réelles en base · transitions vérifiées dans le code et les déclencheurs · v2.0</size>

state "Alerte de décrochage" as AD {
  [*] --> OUVERTE : balayage (critère factuel)
  OUVERTE --> TRAITEE : action saisie
  TRAITEE -up-> OUVERTE : rouvrir (motif)
}
state "Alerte de surveillance (IA)" as AS {
  [*] --> NOUVEAU : anomalie + photo
  NOUVEAU --> EXAMINE : formateur
  EXAMINE -up-> NOUVEAU : remettre à examiner
}
@enduml
