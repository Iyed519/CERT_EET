# Cert_EET — root .env for Docker Compose
# Local setup (Windows):   copy .env.example .env
# NEVER commit the real .env — only this .example file is committed.

# --- PostgreSQL (INF03 / INF04) ---
POSTGRES_USER=cert_eet
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=cert_eet

# --- Bootstrap admin account (seeded in INF04) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_locally

# --- JWT RS256 keys (INF07) ---
# NOT stored here. They are .pem files generated once with openssl into the
# gitignored  secrets/  folder, then mounted read-only into the api container
# at /run/secrets. On a fresh machine, regenerate them with:
#   mkdir -p secrets
#   openssl genrsa -out secrets/jwt_private.pem 2048
#   openssl rsa -in secrets/jwt_private.pem -pubout -out secrets/jwt_public.pem

# --- OAuth social login (US-AUTH-14) ---
# Real client IDs/secrets come from each provider's developer console and go in
# the real .env only (NEVER commit them). docker-compose.dev.yml reads them from
# here via ${...}. Callback URLs default in code to the Nginx origin.
# Google  -> https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=change_me_locally
GOOGLE_CLIENT_SECRET=change_me_locally
# GitHub  -> https://github.com/settings/developers  (OAuth App)
#   Authorization callback URL: https://localhost/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=change_me_locally
GITHUB_CLIENT_SECRET=change_me_locally

# --- Minuterie des tentatives de QCM (US-QCM-07) ---
# Optional (default true). Every 60 s the API closes EN_COURS attempts whose
# deadline passed more than 30 s ago. Always off when NODE_ENV=test.
# MINUTERIE_BALAYAGE_ACTIF=true

# --- Stockage objet MinIO / S3 (US-ATEL-04, ADR-07) ---
# MinIO stocke les livrables des ateliers. Ces identifiants sont ceux du compte
# racine MinIO ; l'api les utilise aussi pour se connecter (réseau docker privé,
# MinIO n'est pas publié sur l'hôte). Mot de passe : 8 caractères au moins.
MINIO_ROOT_USER=change_me_locally
MINIO_ROOT_PASSWORD=change_me_locally
S3_BUCKET_LIVRABLES=livrables

# --- Certificats (US-CERT-01) : file BullMQ sur le Redis ci-dessus ---
# Facultatif (valeurs par défaut). CERTIFICATS_WORKER=off coupe le worker
# intégré à l'api ; tentatives et délai de reprise (ms, exponentiel).
CERTIFICATS_WORKER=on
CERTIFICATS_TENTATIVES=3
CERTIFICATS_BACKOFF_MS=5000

# --- Vérification publique (US-CERT-05) ---
# Facultatif. Requêtes par minute et par IP sur /api/verification (DS-05 : 20).
VERIFICATION_LIMITE_PAR_MINUTE=20
# Proxies de confiance pour l'IP du visiteur (X-Forwarded-For de nginx).
TRUST_PROXY=loopback, uniquelocal

# --- Assistance IA (US-IA-01) : indexation des supports (file BullMQ) ---
# Facultatif (valeurs par défaut). IA_WORKER=off coupe le worker intégré à
# l'api ; tentatives et délai de reprise (ms, exponentiel). Embeddings :
# « hachage » (calcul local, sans clé ni réseau).
IA_WORKER=on
IA_TENTATIVES=3
IA_BACKOFF_MS=5000
EMBEDDINGS_FOURNISSEUR=hachage
# US-IA-02 : générations de questions par formateur et par heure.
IA_GENERATIONS_PAR_HEURE=10
