@startuml Cert_EET_ETAT-05_Etats_Formation_et_Inscription
!include ../_style.puml
!pragma layout elk
skinparam DefaultFontSize 11
skinparam ArrowColor #34495E
skinparam note {
  BackgroundColor #FEF9E7
  BorderColor #B7950B
  FontSize 10
}
skinparam state {
  BackgroundColor #FFFFFF
  BorderColor #1B4F72
}
title <size:14><b>Cert_EET — ETAT-05 : cycle de vie — Formation et Inscription</b></size>\n<size:10>États = valeurs réelles en base · transitions vérifiées dans le code et les déclencheurs · v2.0</size>

state Formation {
  [*] --> BROUILLON : création / proposition acceptée
  BROUILLON --> OUVERTE : publication
  OUVERTE --> FERMEE : clôture
  FERMEE -up-> OUVERTE : réouverture
  FERMEE --> ARCHIVEE : archivage (définitif)
}
state Inscription {
  [*] --> I_EN_COURS : inscription
  I_EN_COURS --> SUSPENDUE : désinscription / suspension (motif)
  SUSPENDUE -up-> I_EN_COURS : réactivation (administrateur)
  I_EN_COURS --> TERMINEE : (aucun flux applicatif —\njeu de démonstration seulement)
}
@enduml
