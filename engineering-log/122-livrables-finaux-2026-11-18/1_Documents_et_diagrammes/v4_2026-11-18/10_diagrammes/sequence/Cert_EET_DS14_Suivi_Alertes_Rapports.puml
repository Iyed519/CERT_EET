@startuml Cert_EET_DS14_Suivi_Alertes_Rapports
!include ../_style.puml
' =====================================================================
'  Projet    : Cert_EET
'  Diagramme : DS-14 — Suivi pédagogique, alertes et rapports (formateur)
'  Acteur(s) : Formateur affecté, Système (balayage)
'  Réf.      : F6 · US-SUIVI-01/02/03 · US-RPT-01 · US-DASH-03 · US-QCM-17
'  Auteur    : Iyed Omri — PFE ESPRIT 2026
'  Version   : 2.0 — 18/11/2026 : réécrit d'après le code (PR #71 → #74, #99, #128 ; journaux 58–61, 85, 108).
'  Source    : code de `main` = e7216f2 (PR #141) et engineering-log/
' =====================================================================
!pragma teoz true
autonumber "<b>0."
skinparam DefaultFontSize 10
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 18
skinparam LifeLineBorderThickness 1.0
skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #5D6D7E
}
skinparam actor {
  BackgroundColor #ECF0F1
  BorderColor #1B4F72
  FontStyle bold
}
skinparam database {
  BackgroundColor #EBF5FB
  BorderColor #1B4F72
}
skinparam collections {
  BackgroundColor #E8F8F5
  BorderColor #1E8449
}
skinparam control {
  BackgroundColor #FAE5D3
  BorderColor #BA4A00
}
skinparam entity {
  BackgroundColor #E8DAEF
  BorderColor #7D3C98
}
skinparam boundary {
  BackgroundColor #FDEDEC
  BorderColor #943126
}
skinparam note {
  BackgroundColor #FEF9E7
