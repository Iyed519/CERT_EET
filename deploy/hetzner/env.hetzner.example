# Cert_EET — .env de l'hôte de démonstration en ligne (modèle)
#
# Copié en « .env » à la racine du dépôt par deploy/hetzner/scripts/preparer.sh, qui remplit
# les mots de passe internes au hasard. Les autres secrets se saisissent sans les afficher :
#   deploy/hetzner/scripts/definir-secret.sh NOM_DE_LA_VARIABLE
# Ce fichier-ci est committé : il ne contient AUCUNE valeur réelle.

# --- Fichiers compose (évite les -f) ---
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml:deploy/hetzner/docker-compose.hetzner.yml

# --- Adresse publique (sans https://) ---
DOMAINE=cert-eet.duckdns.org

# --- PostgreSQL ---
POSTGRES_USER=cert_eet
POSTGRES_PASSWORD=__ALEATOIRE__
POSTGRES_DB=cert_eet

# --- Compte administrateur initial ---
ADMIN_EMAIL=admin@cert-eet.tn
ADMIN_PASSWORD=__ALEATOIRE__

# --- MinIO (stockage des livrables) ---
MINIO_ROOT_USER=cert_eet_minio
MINIO_ROOT_PASSWORD=__ALEATOIRE__
S3_BUCKET_LIVRABLES=livrables

# --- OAuth : applications DÉDIÉES au domaine ---
# GitHub : https://github.com/settings/developers -> OAuth App
#   Homepage URL : https://<DOMAINE> ; callback : https://<DOMAINE>/api/auth/oauth/github/callback
# Google : console Google Cloud -> Google Auth Platform -> client « Application Web »
#   Origine : https://<DOMAINE> ; redirection : https://<DOMAINE>/api/auth/oauth/google/callback
#   (aucun essai payant nécessaire)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mails réels (Gmail, mot de passe d'APPLICATION de 16 lettres) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Même adresse que SMTP_USER, sinon Gmail réécrit l'expéditeur.
MAIL_FROM=

# --- Assistance IA (clé dédiée au serveur) ---
LLM_FOURNISSEUR=
LLM_MODELE=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# --- Divers (valeurs de .env.example) ---
TRUST_PROXY=loopback, uniquelocal
VERIFICATION_LIMITE_PAR_MINUTE=20
CERTIFICATS_WORKER=on
IA_WORKER=on
EMBEDDINGS_FOURNISSEUR=hachage
IA_GENERATIONS_PAR_HEURE=10
RESSOURCES_TAILLE_MAX_MO=500
